---
interface Props {
  title: string;
  description: string;
  learning: string;
  technologies: string[];
  github: string;
}
const { title, description, learning, technologies, github } = Astro.props;
---

<article class="card group flex h-full flex-col p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/30">
  <div class="mb-5 flex items-start justify-between gap-4">
    <div>
      <span class="text-xs uppercase tracking-[.2em] text-violet-300">Projeto</span>
      <h3 class="mt-2 text-xl font-semibold text-white">{title}</h3>
    </div>
    <a
      href={github}
      target="_blank"
      rel="noreferrer"
      class="pill px-3 py-2 text-xs text-zinc-300 transition hover:bg-white/10"
    >
      GitHub ↗
    </a>
  </div>

  <p class="leading-7 text-zinc-400">{description}</p>

  <div class="mt-5 rounded-2xl border border-white/8 bg-white/[.025] p-4">
    <p class="text-xs font-semibold uppercase tracking-[.18em] text-zinc-500">Aprendizado</p>
    <p class="mt-2 text-sm leading-6 text-zinc-400">{learning}</p>
  </div>

  <div class="mt-auto flex flex-wrap gap-2 pt-6">
    {technologies.map((technology) => (
      <span class="pill px-3 py-1.5 text-xs text-zinc-300">{technology}</span>
    ))}
  </div>
</article>
