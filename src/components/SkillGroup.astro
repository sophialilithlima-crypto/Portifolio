---
interface Props {
  title: string;
  items: string[];
  icon: string;
  accent: string;
}

const { title, items, icon, accent } = Astro.props;

const slugify = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<div class="card skill-group h-full p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/35">
  <div class="flex items-start gap-4">
    <div class={`skill-icon ${accent}`} aria-hidden="true">
      <span>{icon}</span>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.18em] text-violet-300">Conhecimentos</p>
      <h3 class="mt-1 text-lg font-semibold text-white">{title}</h3>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
    {items.map((item) => (
      <div class="tool-chip">
        <img class="tool-image" src={`${import.meta.env.BASE_URL}images/tools/${slugify(item)}.svg`} alt={`${item} — ícone`} loading="lazy" />
        <span class="tool-label">{item}</span>
      </div>
    ))}
  </div>
</div>
