---
import type { Tool } from "../domain/profile";

interface Props {
  title: string;
  items: Tool[];
  icon: string;
  accent: string;
}

const { title, items, icon, accent } = Astro.props;
---

<div class="card skill-group h-full p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-300/45">
  <div class="flex items-start gap-4">
    <div class={`skill-icon ${accent}`} aria-hidden="true"><span>{icon}</span></div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-[.18em] text-violet-300">Conhecimentos</p>
      <h3 class="mt-1 text-lg font-semibold text-white">{title}</h3>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-2">
    {items.map((item) => (
      <div class="tool-card" title={item.name}>
        <div class="tool-logo-shell" aria-hidden="true">
          {item.logo ? (
            <img
              src={`https://cdn.simpleicons.org/${item.logo}/${item.color ?? "7C3AED"}`}
              alt=""
              class:list={{ "logo-invert-dark": item.invertDark }}
              loading="lazy"
              referrerpolicy="no-referrer"
            />
          ) : (
            <svg class="algorithm-logo" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="12" cy="12" r="4" fill="currentColor" />
              <circle cx="36" cy="12" r="4" fill="currentColor" />
              <circle cx="24" cy="36" r="4" fill="currentColor" />
              <path d="M15 14.5 21 32M33 14.5 27 32M16 12h16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            </svg>
          )}
        </div>
        <span>{item.name}</span>
      </div>
    ))}
  </div>
</div>
