---
interface Props {
  title: string;
  summary: string;
  tags: string[];
  eyebrow: string;
  lang?: "pt" | "en";
}

const { title, summary, tags, eyebrow, lang = "pt" } = Astro.props;
const base = import.meta.env.BASE_URL;
const labels = lang === "en"
  ? { previous: "Previous artwork", next: "Next artwork", first: "Drawing", second: "Watercolor" }
  : { previous: "Trabalho anterior", next: "Próximo trabalho", first: "Desenho", second: "Aquarela" };
---

<article class="card creative-card p-6">
  <div class="art-carousel" data-art-carousel>
    <div class="art-carousel-viewport">
      <figure class="art-slide is-active" data-slide="0">
        <img
          src={`${base}images/desenho.jpeg`}
          alt={lang === "en" ? "Pencil drawing by Sophia" : "Desenho a lápis feito por Sophia"}
        />
        <figcaption>{labels.first}</figcaption>
      </figure>

      <figure class="art-slide" data-slide="1" aria-hidden="true">
        <img
          src={`${base}images/aquarela.jpeg`}
          alt={lang === "en" ? "Watercolor painting by Sophia" : "Pintura em aquarela feita por Sophia"}
        />
        <figcaption>{labels.second}</figcaption>
      </figure>
    </div>

    <button class="art-arrow art-arrow-left" type="button" data-art-prev aria-label={labels.previous}>
      <span aria-hidden="true">←</span>
    </button>
    <button class="art-arrow art-arrow-right" type="button" data-art-next aria-label={labels.next}>
      <span aria-hidden="true">→</span>
    </button>

    <div class="art-counter" aria-live="polite">
      <span data-art-current>1</span><span aria-hidden="true"> / </span><span>2</span>
    </div>

    <div class="art-dots" aria-label={lang === "en" ? "Artwork selector" : "Seletor de trabalhos"}>
      <button type="button" class="art-dot is-active" data-art-dot="0" aria-label={`${labels.first} — 1`} aria-current="true"></button>
      <button type="button" class="art-dot" data-art-dot="1" aria-label={`${labels.second} — 2`} aria-current="false"></button>
    </div>
  </div>

  <div class="pt-6">
    <p class="text-xs font-semibold uppercase tracking-[.18em] text-violet-300">{eyebrow}</p>
    <h3 class="mt-2 text-2xl font-semibold text-white">{title}</h3>
    <p class="mt-3 leading-7 text-zinc-400">{summary}</p>
    <div class="achievement-tags mt-5">
      {tags.map((tag) => <span class="achievement-tag">{tag}</span>)}
    </div>
  </div>
</article>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-art-carousel]");

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-art-dot]"));
    const current = carousel.querySelector<HTMLElement>("[data-art-current]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-art-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-art-next]");
    let index = 0;

    const show = (nextIndex: number) => {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });

      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-current", active ? "true" : "false");
      });

      if (current) current.textContent = String(index + 1);
    };

    previous?.addEventListener("click", () => show(index - 1));
    next?.addEventListener("click", () => show(index + 1));
    dots.forEach((dot, dotIndex) => dot.addEventListener("click", () => show(dotIndex)));

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(index - 1);
      if (event.key === "ArrowRight") show(index + 1);
    });

    carousel.setAttribute("tabindex", "0");
  });
</script>
