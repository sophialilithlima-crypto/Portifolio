---
import Layout from "../../layouts/Layout.astro";
import { profile, projects, skills } from "../../domain/profile";
---

<Layout lang="pt" cv title={`CV — ${profile.name}`} description="Currículo de Sophia Lilith.">
  <div class="print-page mx-auto min-h-screen max-w-[900px] px-6 py-10 text-zinc-900 sm:px-10">
    <div class="no-print mb-8 flex justify-between gap-4">
      <a href={`${import.meta.env.BASE_URL}pt/`} class="text-sm text-zinc-500 hover:text-zinc-900">← Voltar ao portfólio</a>
      <button onclick="window.print()" class="rounded-full bg-zinc-900 px-4 py-2 text-sm text-white">Imprimir / salvar PDF</button>
    </div>

    <header class="border-b-2 border-zinc-900 pb-7">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[.2em] text-violet-700">Desenvolvedora em formação</p>
          <h1 class="mt-2 text-4xl font-bold tracking-tight">{profile.name}</h1>
          <p class="mt-2 text-zinc-600">Estudante do ensino médio • Interesse em desenvolvimento de jogos</p>
        </div>
        <img src={`${import.meta.env.BASE_URL}images/sophia.jpg`} alt="Foto de Sophia Lilith" class="h-28 w-24 rounded-2xl object-cover" />
      </div>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600">
        <span>{profile.email}</span>
        <a href={profile.github}>{profile.github.replace("https://", "")}</a>
        <span>Instagram: @Sophiaalilih</span>
      </div>
    </header>

    <section class="mt-8">
      <h2 class="text-lg font-bold uppercase tracking-wide">Perfil</h2>
      <p class="mt-3 leading-7 text-zinc-700">
        Sou Sophia Lilith, estudante do ensino médio e desenvolvedora em formação. Comecei a estudar programação no início de 2026 e venho desenvolvendo meus primeiros projetos para transformar o aprendizado em prática. Tenho interesse especial pela área de desenvolvimento de jogos e meu objetivo é continuar adquirindo conhecimento e construir gradualmente minha carreira como desenvolvedora.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-bold uppercase tracking-wide">Tecnologias e conhecimentos</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {Object.entries(skills).map(([group, items]) => (
          <div>
            <h3 class="font-semibold">{group}</h3>
            <p class="mt-1 text-sm leading-6 text-zinc-600">{items.join(" • ")}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-bold uppercase tracking-wide">Projetos</h2>
      <div class="mt-4 space-y-6">
        {projects.map((project) => (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold">{project.title}</h3>
              <a href={project.github} class="text-sm text-violet-700">{project.github}</a>
            </div>
            <p class="mt-2 text-sm leading-6 text-zinc-700">{project.description}</p>
            <p class="mt-1 text-sm leading-6 text-zinc-600"><strong>Aprendizado:</strong> {project.learning}</p>
            <p class="mt-1 text-xs text-zinc-500">{project.technologies.join(" • ")}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-8 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-lg font-bold uppercase tracking-wide">Formação</h2>
        <p class="mt-3 text-sm leading-6 text-zinc-700">Ensino médio — em andamento.</p>
      </div>
      <div>
        <h2 class="text-lg font-bold uppercase tracking-wide">Idiomas</h2>
        <p class="mt-3 text-sm leading-6 text-zinc-700">Português — nativo<br />Inglês — intermediário</p>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-bold uppercase tracking-wide">Objetivo</h2>
      <p class="mt-3 text-sm leading-6 text-zinc-700">
        Continuar desenvolvendo conhecimentos em programação, explorar novas tecnologias e adquirir experiência por meio de projetos, com interesse especial em desenvolvimento de jogos.
      </p>
    </section>
  </div>
</Layout>
